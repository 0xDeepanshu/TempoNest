# -----------------------------------------------------------------------------
# TempoNest Monorepo Root .gitignore
# -----------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Production and intermediate build outputs
dist/
build/
out/
release/
.next/
*.tsbuildinfo
next-env.d.ts

# Testing & code coverage
coverage/
*.lcov
.nyc_output/

# Environment configurations and secret keys
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.local

# Local data stores, databases, and uploaded artifacts
/backend/storage/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db3

# Runtime and debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# OS and Editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.qoder/
skills-lock.json

# Deployment metadata
.vercel/
