# ---------------------------------------------------------------------------
# WorkZen / TempoNest mobile app - PRODUCTION example.
#
# EXPO_PUBLIC_* values are embedded in the JS bundle and visible to users;
# never put secrets here. Set the same value in the EAS build profile or the
# build environment. Include the /api/v1 prefix and use HTTPS.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_API_BASE_URL=https://api.workzen.cloud/api/v1
