# TempoNest mobile API origin. Include the /api/v1 prefix.
#
# When this is unset, development builds use:
#   Android emulator  -> http://10.0.2.2:4000/api/v1
#   iOS simulator/web -> http://localhost:4000/api/v1
#
# Physical device on the same network (replace with your computer's LAN IP,
# which you can find with `ipconfig`). Copy this file to `.env.local`, which is
# gitignored, and restart Expo with `--clear`.
# The host must match the backend's PUBLIC_BASE_URL so private attendance
# evidence upload URLs are reachable from the phone.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:4000/api/v1
#
# Production builds require an explicit https origin; there is no production
# default. The app refuses to start without it.
# EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.example/api/v1
