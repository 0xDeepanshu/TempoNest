# Base URL of the TempoNest Express API. Server-side only; no secrets belong here.
BACKEND_API_URL=http://localhost:4000

# Browser-reachable WebSocket origin of the TempoNest backend, used only for the
# admin live-screen relay. Baked in at build time, so rebuild after changing it.
# Use wss:// in production and ws:// only for local development.
NEXT_PUBLIC_API_WS_URL=ws://localhost:4000
