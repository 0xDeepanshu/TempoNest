# ---------------------------------------------------------------------------
# WorkZen / TempoNest web portal - PRODUCTION example.
#
# Copy to `.env.production` before `npm run build`. BACKEND_API_URL is read by
# the server-side BFF at runtime; NEXT_PUBLIC_API_WS_URL is baked into the
# browser bundle at build time and requires a rebuild when changed.
# No secrets belong in this file.
# ---------------------------------------------------------------------------

# Backend API origin (no /api/v1 suffix, no trailing slash).
BACKEND_API_URL=https://api.workzen.cloud

# Browser-reachable WebSocket origin of the backend, used only for the admin
# live-screen relay. Use wss:// in production.
NEXT_PUBLIC_API_WS_URL=wss://api.workzen.cloud
