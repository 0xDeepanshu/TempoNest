# ---------------------------------------------------------------------------
# WorkZen / TempoNest backend - PRODUCTION example.
#
# Copy to `.env` on the server and replace every CHANGE_ME placeholder.
# Never commit the filled-in file. Replace example hostnames with the real
# ones before starting the service; the app refuses to boot with an invalid
# production configuration.
# ---------------------------------------------------------------------------

NODE_ENV=production
# 4100 avoids the existing Flowtrium backend on port 4000.
PORT=4100

# --- Database -----------------------------------------------------------------
# Preferred form. Percent-encode special characters in the password.
DATABASE_URL=postgresql://workzen_app:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/workzen
DB_SSL=false
# Alternative to DATABASE_URL (all three must be set explicitly):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=workzen
# DB_USER=workzen_app
# DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Auth / secrets -----------------------------------------------------------
# Generate with: openssl rand -base64 48
TOKEN_PEPPER=CHANGE_ME_OPENSSL_RAND_BASE64_48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=1800
MAX_ACTIVE_SESSIONS_PER_USER=10
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900

# --- Outbound e-mail ----------------------------------------------------------
# Production requires a working SMTP relay because invitations and password
# resets are sent by e-mail. Set both SMTP_USER and SMTP_PASSWORD, or neither
# for an unauthenticated relay.
MAIL_TRANSPORT=smtp
MAIL_FROM=WorkZen <no-reply@workzen.cloud>
WEB_APP_URL=https://app.workzen.cloud
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Cookies ------------------------------------------------------------------
# TLS terminates at Nginx; keep Secure cookies on.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# host-only cookie when empty
COOKIE_DOMAIN=

# --- HTTP / CORS --------------------------------------------------------------
# Exact browser origin(s) of the web app, comma-separated.
CORS_ORIGINS=https://app.workzen.cloud
# 1 when Nginx is the only reverse proxy in front of Node.
TRUST_PROXY=1

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info

# --- Screenshots / attendance evidence ----------------------------------------
# Private local storage. The directory must exist, be owned by the service
# user, and must not be served by Nginx directly.
SCREENSHOT_STORAGE_DRIVER=local
SCREENSHOT_LOCAL_DIR=/var/lib/workzen/storage/screenshots
# Public HTTPS origin of this API, used to build signed upload/download URLs.
# No trailing slash and no /api/v1 suffix.
PUBLIC_BASE_URL=https://api.workzen.cloud
SCREENSHOT_REQUEST_TTL_SECONDS=300
SCREENSHOT_UPLOAD_TTL_SECONDS=120
SCREENSHOT_DOWNLOAD_TTL_SECONDS=300
SCREENSHOT_CLEANUP_INTERVAL_SECONDS=300
SCREENSHOT_MAX_BYTES=10485760
SCREENSHOT_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp

# Private S3-compatible storage is optional. Leave the driver as `local`
# above unless you deliberately move binaries off the server.
# SCREENSHOT_STORAGE_DRIVER=s3
# SCREENSHOT_S3_BUCKET=
# SCREENSHOT_S3_REGION=us-east-1
# SCREENSHOT_S3_ENDPOINT=
# SCREENSHOT_S3_ACCESS_KEY_ID=
# SCREENSHOT_S3_SECRET_ACCESS_KEY=
# SCREENSHOT_S3_FORCE_PATH_STYLE=false

# Live screen relay: memory-only frames. Nginx must upgrade WebSockets on
# /api/v1/ws/screen-live and /api/v1/ws/screen-stream.
SCREEN_LIVE_MAX_SESSION_SECONDS=900
SCREEN_LIVE_VIEWER_TICKET_TTL_SECONDS=60
SCREEN_LIVE_MAX_FPS=2
SCREEN_LIVE_MAX_FRAME_BYTES=2097152
SCREEN_LIVE_MAX_FRAME_WIDTH=1600
SCREEN_LIVE_VIEWER_BUFFER_LIMIT_BYTES=1048576
SCREEN_LIVE_AGENT_GRACE_SECONDS=10
SCREEN_LIVE_VIEWER_GRACE_SECONDS=8

# --- Mobile attendance location ----------------------------------------------
ATTENDANCE_UPLOAD_TTL_SECONDS=120
ATTENDANCE_EVIDENCE_TTL_SECONDS=900
ATTENDANCE_EVIDENCE_DOWNLOAD_TTL_SECONDS=300
ATTENDANCE_LOCATION_MAX_ACCURACY_METERS=500
ATTENDANCE_LOCATION_MAX_AGE_SECONDS=300
ATTENDANCE_LOCATION_FUTURE_SKEW_SECONDS=60
ATTENDANCE_LOCATION_SAMPLE_MAX_ACCURACY_METERS=500
ATTENDANCE_LOCATION_MAX_SAMPLES_PER_REQUEST=50
ATTENDANCE_LOCATION_STALE_SECONDS=180
ATTENDANCE_LOCATION_RETENTION_DAYS=30
ATTENDANCE_LOCATION_PURGE_INTERVAL_SECONDS=21600

# --- Leave accrual ------------------------------------------------------------
LEAVE_ACCRUAL_SWEEP_INTERVAL_SECONDS=3600

# --- Time tracking / desktop agents ------------------------------------------
HEARTBEAT_STALE_SECONDS=120
SESSION_STALE_SECONDS=600
OFFLINE_MAX_BACKFILL_SECONDS=604800
OFFLINE_FUTURE_SKEW_SECONDS=300
ACTIVITY_MAX_BACKFILL_SECONDS=2592000
ACTIVITY_FUTURE_SKEW_SECONDS=60
ACTIVITY_RETENTION_PURGE_INTERVAL_SECONDS=21600
WS_MAX_PAYLOAD_BYTES=32768
WS_SWEEP_INTERVAL_SECONDS=30
BODY_LIMIT=100kb
