# ---------------------------------------------------------------------------
# TempoNest backend - example configuration. Copy to `.env` and fill in.
# All values below are placeholders. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# API_PREFIX is fixed to /api/v1 in code; listed for documentation only.

# --- Database -----------------------------------------------------------------
# Preferred: a single connection string, e.g.
# DATABASE_URL=postgresql://user:password@localhost:5432/temponest_dev
# Leave empty to use the DB_* values below.
DATABASE_URL=
# Set to "true" when your managed PostgreSQL requires TLS.
DB_SSL=false
# Used only when DATABASE_URL is empty:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=temponest_dev
DB_USER=postgres
DB_PASSWORD=change-me

# --- Auth / secrets -----------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`.
# Required in production. Used to HMAC opaque tokens before they are stored.
TOKEN_PEPPER=replace-with-at-least-32-random-characters

# Session lifetimes (seconds).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800
MAX_ACTIVE_SESSIONS_PER_USER=10

# --- Argon2id -----------------------------------------------------------------
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Cookies ------------------------------------------------------------------
# `true` in production. Browsers require Secure for SameSite=None.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional cookie domain, e.g. `.temponest.example.com`
COOKIE_DOMAIN=

# --- HTTP / CORS --------------------------------------------------------------
# Comma-separated exact origins. Never use "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
# Set to "true" to log SQL in development.
DB_LOGGING=false

# --- Time tracking / desktop agents ------------------------------------------
# A session counts as "working/on break" only while its heartbeat is fresh.
HEARTBEAT_STALE_SECONDS=120
# An open session older than this is closed at its last heartbeat when the
# employee starts a new one (crash/network-loss recovery).
SESSION_STALE_SECONDS=600
# Offline event acceptance windows (seconds).
OFFLINE_MAX_BACKFILL_SECONDS=604800
OFFLINE_FUTURE_SKEW_SECONDS=300
# Application-metadata acceptance windows (seconds).
ACTIVITY_MAX_BACKFILL_SECONDS=2592000
ACTIVITY_FUTURE_SKEW_SECONDS=60
# Agent WebSocket limits.
WS_MAX_PAYLOAD_BYTES=32768
WS_SWEEP_INTERVAL_SECONDS=30

# --- HTTP body limit ----------------------------------------------------------
BODY_LIMIT=100kb

# --- Admin-initiated screenshots ---------------------------------------------
# Capture is disabled per organization until an OWNER/ADMIN enables the
# monitoring policy through PATCH /api/v1/admin/screenshot-policy.
# `local` writes private files under SCREENSHOT_LOCAL_DIR. `s3` uses a private
# S3-compatible bucket and short-lived presigned upload/download URLs.
SCREENSHOT_STORAGE_DRIVER=local
SCREENSHOT_LOCAL_DIR=storage/screenshots
# Used to build local upload/download URLs. Set the public HTTPS origin in
# production (required for local storage there).
PUBLIC_BASE_URL=http://localhost:4000
SCREENSHOT_REQUEST_TTL_SECONDS=300
SCREENSHOT_UPLOAD_TTL_SECONDS=120
SCREENSHOT_DOWNLOAD_TTL_SECONDS=300
SCREENSHOT_CLEANUP_INTERVAL_SECONDS=300
SCREENSHOT_MAX_BYTES=10485760
SCREENSHOT_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp

# S3-compatible private object storage (when SCREENSHOT_STORAGE_DRIVER=s3).
# Credentials are optional when the runtime uses an IAM role.
SCREENSHOT_S3_BUCKET=
SCREENSHOT_S3_REGION=us-east-1
SCREENSHOT_S3_ENDPOINT=
SCREENSHOT_S3_ACCESS_KEY_ID=
SCREENSHOT_S3_SECRET_ACCESS_KEY=
SCREENSHOT_S3_FORCE_PATH_STYLE=false

# --- Mobile attendance evidence ----------------------------------------------
# Evidence uses the screenshot storage driver, size cap, and allowed content
# types above. Upload slots and unsent evidence records expire quickly.
ATTENDANCE_UPLOAD_TTL_SECONDS=120
ATTENDANCE_EVIDENCE_TTL_SECONDS=900
ATTENDANCE_EVIDENCE_DOWNLOAD_TTL_SECONDS=300
# Location must be at most this inaccurate, no older than this, and no more
# than the future skew ahead of server time. Required for ON_SITE, optional for
# WFH, and rejected for WFO. No geofencing is applied.
ATTENDANCE_LOCATION_MAX_ACCURACY_METERS=500
ATTENDANCE_LOCATION_MAX_AGE_SECONDS=300
ATTENDANCE_LOCATION_FUTURE_SKEW_SECONDS=60

# --- Tests (optional) ---------------------------------------------------------
# When unset, the test suite uses an in-memory SQLite database.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/temponest_test
