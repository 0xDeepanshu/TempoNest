# ---------------------------------------------------------------------------
# WorkZen / TempoNest desktop agent - PRODUCTION example.
#
# Copy to `.env.production` before running `npm run package`, or export the
# same MAIN_VITE_* variables in the build shell. electron-vite inlines these
# values into the packaged main process; a packaged app has no shell
# environment, so the localhost fallback is otherwise used.
#
# At runtime, TEMPO_API_BASE_URL and TEMPO_WS_URL in the process environment
# still take precedence over these baked values.
# ---------------------------------------------------------------------------

# Include the /api/v1 prefix here.
MAIN_VITE_TEMPO_API_BASE_URL=https://api.workzen.cloud/api/v1

# Optional. When omitted, the agent derives wss://<api host>/api/v1/ws/agent.
MAIN_VITE_TEMPO_WS_URL=wss://api.workzen.cloud/api/v1/ws/agent
